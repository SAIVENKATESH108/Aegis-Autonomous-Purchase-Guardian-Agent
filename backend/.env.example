# Aegis — Autonomous Purchase Guardian Agent
# Environment Configuration Template
# Copy this file to .env and fill in your credentials

# ============================================================
# Amazon Bedrock Settings (OPTIONAL)
# If these are left blank, Aegis runs in autonomous local
# heuristic mode with full functionality — no AWS required.
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Amazon Bedrock Model (Claude 3 Haiku recommended for speed)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ============================================================
# Database (SQLite by default — no changes needed locally)
# ============================================================
DATABASE_URL=sqlite:///./aegis_guardian.db

# ============================================================
# Guardian Triage Thresholds
# ============================================================
RETURN_WINDOW_WARNING_DAYS=5   # Alert when <= 5 days left in return window
WARRANTY_WARNING_DAYS=14       # Alert when <= 14 days left in warranty

# ============================================================
# Notifications (Optional — Telegram)
# ============================================================
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id
